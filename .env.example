APP_NAME=Chartes.Tech
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# AWS & DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# For local development with DynamoDB Local (e.g. via infra/docker-compose.yml):
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# DynamoDB Table Names (PRD Pragmatic 3-Table Design)
DYNAMODB_TABLE_USERS_WORKSPACES=chartes_users_workspaces
DYNAMODB_TABLE_SOCIAL_ACCOUNTS=chartes_social_accounts
DYNAMODB_TABLE_POSTS_JOBS=chartes_posts_jobs